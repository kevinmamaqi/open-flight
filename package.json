{
  "name": "open-flight",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.0.0"
  },
  "scripts": {
    "studio": "bun apps/api/server.ts",
    "editor": "node apps/api/server.ts",
    "mcp": "node apps/mcp-server/server.ts",
    "test": "bun test --timeout 120000 tests",
    "typecheck": "bun --bun tsc --noEmit",
    "check:editor": "node scripts/check_editor.ts",
    "journey": "bun examples/agent-client/journey.ts",
    "build:workshop": "bun scripts/build_library.mjs && bun scripts/build_flight_objects.mjs && bun scripts/build_browser.mjs && bun scripts/build_book.mjs && bun scripts/build_book_sizes.mjs && bun scripts/build_book_covers.mjs",
    "build:site": "bun run build:workshop && bun scripts/build_site.mjs docs",
    "build:cloudflare": "bun run build:workshop && bun scripts/build_site.mjs dist/cloudflare-input --cloudflare && bun scripts/prepare_pages.mjs dist/cloudflare-input dist/cloudflare",
    "check:design": "bun scripts/build_tokens.mjs --check && bun scripts/check_design.mjs",
    "check:print": "bun scripts/check_print_design.mjs",
    "check:ui": "bun scripts/check_ui.mjs",
    "build:tokens": "bun scripts/build_tokens.mjs",
    "test:compat": "node --test --test-name-pattern \"checked-in airplane specimens\" tests/plane-atlas.test.ts",
    "check:site": "bun scripts/check_site.mjs",
    "check:atlas": "bun scripts/check_atlas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "dejavu-fonts-ttf": "2.37.3",
    "jspdf": "4.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@noble/hashes": "2.4.0",
    "@types/node": "24.19.2",
    "buffer": "6.0.3",
    "playwright-core": "1.59.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
